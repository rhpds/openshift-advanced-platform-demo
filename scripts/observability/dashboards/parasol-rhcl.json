  {
   "id": 34,
   "type": "stat",
   "title": "Requests / s through the gateway",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(sum by (response_code) (max by (pod, response_code) (rate(istio_requests_total{source_workload=\"parasol-gateway-istio\"}[2m]))))",
     "legendFormat": "req/s",
     "refId": "H"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
