    {
      "name": "7. End-to-end trace: OSSM gateway + Connectivity Link + backend",
      "description": "One request with a W3C traceparent through the governed API, then its trace from Tempo (query API published through the gateway, platform key). Run once, in order.",
      "item": [
        {
          "name": "traced call to the Parasol API",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "APIKEY {{partner_api_key}}"
              },
              {
                "key": "traceparent",
                "value": "00-{{trace_id}}-{{span_id}}-01"
              }
            ],
            "url": "https://parasol-api-parasol-insurance-prod.{{domain}}/api/claims"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hex = n => [...Array(n)].map(() => Math.floor(Math.random()*16).toString(16)).join('');",
                  "pm.environment.set('trace_id', hex(32)); pm.environment.set('span_id', hex(16));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 through the gateway', () => pm.response.to.have.status(200));",
                  "pm.test('claims returned by the backend', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "the trace crosses gateway, Authorino, Limitador and reaches the backend",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{platform_api_key}}"
              }
            ],
            "url": "https://traces-api.{{domain}}/api/traces/{{trace_id}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tempo needs a few seconds to index the spans",
                  "setTimeout(() => {}, 8000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 from the traces API', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "const services = new Set(); const upstreams = [];",
                  "for (const b of (t.batches || [])) { for (const a of (b.resource.attributes || [])) if (a.key === 'service.name') services.add(a.value.stringValue); for (const ss of (b.scopeSpans || [])) for (const s of (ss.spans || [])) for (const a of (s.attributes || [])) if (a.key === 'upstream_cluster') upstreams.push(a.value.stringValue); }",
                  "pm.test('OSSM: gateway span', () => pm.expect([...services].some(s => s.startsWith('parasol-gateway-istio'))).to.be.true);",
                  "pm.test('Connectivity Link: Authorino span', () => pm.expect(services.has('authorino')).to.be.true);",
                  "pm.test('Connectivity Link: Limitador span', () => pm.expect(services.has('limitador')).to.be.true);",
                  "pm.test('backend: gateway forwarded to parasol-insurance (prod)', () => pm.expect(upstreams.some(u => u.includes('parasol-insurance.parasol-insurance-prod'))).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "traces API without key -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://traces-api.{{domain}}/api/search?limit=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}