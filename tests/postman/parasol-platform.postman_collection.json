    {
      "name": "4. Connectivity Link: rate limit (run with delay 0 ms)",
      "item": [
        {
          "name": "Burst call (iteration {{iteration}})",
          "request": {
            "method": "GET",
            "url": "https://parasol-api-parasol-insurance-prod.{{domain}}/api/claims",
            "header": [
              {
                "key": "Authorization",
                "value": "APIKEY {{partner_api_key}}"
              }
            ]
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// run this folder alone in the Collection Runner with iterations = 14, delay = 0",
                  "if (pm.info.iteration === 0) { pm.collectionVariables.set('burst_ok', 0); pm.collectionVariables.set('burst_limited', 0); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ok = Number(pm.collectionVariables.get('burst_ok')) + (pm.response.code === 200 ? 1 : 0);",
                  "const limited = Number(pm.collectionVariables.get('burst_limited')) + (pm.response.code === 429 ? 1 : 0);",
                  "pm.collectionVariables.set('burst_ok', ok); pm.collectionVariables.set('burst_limited', limited);",
                  "pm.test('each call is 200 or 429, never anything else', () => pm.expect(pm.response.code).to.be.oneOf([200, 429]));",
                  "if (pm.info.iteration === pm.info.iterationCount - 1) {",
                  "  pm.test('10 requests per 10 s enforced: ' + ok + ' x 200, ' + limited + ' x 429', () => { pm.expect(ok).to.be.within(9, 11); pm.expect(limited).to.be.above(0); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
