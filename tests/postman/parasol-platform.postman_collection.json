    {
      "name": "6. Connectivity Link: MCP server of Developer Hub",
      "description": "Developer Hub's MCP endpoint (the tools Developer Lightspeed uses) published through the parasol-gateway: platform key in X-API-Key, Backstage token injected by the gateway, 10 calls / 10 s per key.",
      "item": [
        {
          "name": "initialize without key -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "url": "https://mcp-developer-hub.{{domain}}/api/mcp-actions/v1",
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\", \"params\": {\"protocolVersion\": \"2025-03-26\", \"capabilities\": {}, \"clientInfo\": {\"name\": \"postman\", \"version\": \"1\"}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 from the gateway (Authorino)', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "initialize with platform key -> Backstage MCP server",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "X-API-Key",
                "value": "{{platform_api_key}}"
              }
            ],
            "url": "https://mcp-developer-hub.{{domain}}/api/mcp-actions/v1",
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\", \"params\": {\"protocolVersion\": \"2025-03-26\", \"capabilities\": {}, \"clientInfo\": {\"name\": \"postman\", \"version\": \"1\"}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "// the MCP server answers as Server-Sent Events: take the JSON of the first 'data:' line",
                  "const line = pm.response.text().split('\\n').find(l => l.startsWith('data:'));",
                  "const msg = line ? JSON.parse(line.slice(5)) : (pm.response.json ? pm.response.json() : {});",
                  "pm.test('server is backstage', () => pm.expect(msg.result.serverInfo.name).to.eql('backstage'));",
                  "pm.test('protocol version negotiated', () => pm.expect(msg.result.protocolVersion).to.be.a('string'));"
                ]
              }
            }
          ]
        },
